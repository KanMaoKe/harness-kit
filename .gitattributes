# 统一换行符：仓库里一律存 LF，检出时按平台自动转换
* text=auto eol=lf

# 二进制
*.zip binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 文档/代码保持 LF（GitHub 上 diff 才干净）
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.tpl  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
